# --- Python basics ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.python-version

# --- Virtual environments / tools ---
.venv/
venv/
env/
.env

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Notebooks / caches / coverage ---
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Logs / temp ---
logs/
*.log
tmp/
.cache/
*.tmp
*.bak

# --- Project-specific rules ---

# Ignore everything in data/ ...
data/*

# ...but DO commit the sports list used by Actions
!data/sports.json

# (optional) keep a readme or placeholder if you want the folder tracked
!data/README.md
!data/.gitkeep
!data/input/
!data/input/.gitkeep
!data/output/
!data/output/.gitkeep

# Keep all odds dumps ignored (large, noisy)
data/odds/

# Debug artefacts from parsing
debug/
data/html/debug/

# PDFs are large - ignore them
forms/*.pdf
data/input/*.pdf

# Allow reports to be committed (probabilities, summaries, bets)
# (Do NOT ignore reports/; the workflows write reports here)

# Keep directory structure with .gitkeep files
!tests/.gitkeep
!forms/.gitkeep

